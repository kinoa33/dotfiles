{
    "layer": "top",
    "position": "top",
    "height": 17,
    "margin-top": 7,
    "margin-left": 25,
    "margin-right": 25,
    "spacing": 5,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",	
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/sysinfo",
        "hyprland/language",
        "tray",
	     "pulseaudio",
        "clock",
        "custom/power"
    ],
    "custom/logo": {
        "format": "\uf17c",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "󰫢",
            "default": "󰫣"		
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },
    "clock": {
        "format": " {:%I:%M %p} ",
        "format-alt": " {:%A %d %B %Y}",
        "tooltip-format": " <big>{:%A %d %B %Y}</big>",
        "on-click": " shift_format"
    },
      "hyprland/language": {
        "format": " {}",
        "format-en": "EN",
        "format-ar": "AR"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9  Muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
           
        "scroll-step": 5,
        "on-click": "pavucontrol" 
    },
    "tray": {
        "icon-size": 17,
        "spacing": 7
    },
    "custom/sysinfo": {
        "exec": "~/.config/waybar/scripts/sysinfo.sh",
        "on-click": "~/.config/waybar/scripts/sysinfo.sh toggle && pkill -RTMIN+8 waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 8
    }
}

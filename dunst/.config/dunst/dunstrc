[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 700
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 15
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#58908C"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = Iosevka Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    always_run_program = true

    corner_radius = 12
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "##71748A"
    foreground = "#E8F0EF"
    timeout = 5

[urgency_normal]
    background = "##71748A"
    foreground = "#E8F0EF"
    timeout = 8

[urgency_critical]
    background = "##71748A"
    foreground = "#FF6B6B"
    frame_color = "##71748A"
    timeout = 0
